{
  "manifest_version": 3,
  "name": "DS5 Web Audio Haptics Extension",
  "version": "1.0",
  "permissions": ["activeTab", "sidePanel", "windows"],
  "host_permissions": ["*://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open DS5 Web Audio Haptics Extension"
  },
  "web_accessible_resources": []
}
